---
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";

const {
	title,
	description,
	creationDate,
	heroImage,
	teamSize,
	timeFrame,
	toolUsed
} = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(creationDate).format("MMMM YYYY");
---
<BaseLayout title={title} description={description} image={heroImage}>
  <main class="toc-layout">
    
<!-- TOC Sidebar / Top Bar -->
<nav id="toc" class="toc-sidebar">
  <div class="toc-header">
    <small><b>Table of Content</b></br></small>
    <button id="toc-toggle" aria-label="Toggle TOC">📖</button>
  </div>
  <ul></ul>
</nav>

    <!-- Main Article -->
    <article
      class="prose prose-lg max-w-[700px] prose-img:mx-0 prose-li:m-0"
      id="post-content"
    >
      {
				heroImage && (
					<div data-lightbox="true">
						<Image
							src={heroImage}
							alt={title}
							class="w-full mb-6 max-w-[900px]"
						/>
					</div>
				)
			}
			<h1 class="title my-2 text-4xl font-bold">{title}</h1>
			{
				creationDate && (
					<>
						<div class="flex items-center">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 448 512"
								fill="currentColor"
								class="mr-2"
							>
								<path
									d="M128 0c17.7 0 32 14.3 32 32V64H288V32c0-17.7 14.3-32 32-32s32 14.3 32 32V64h48c26.5 0 48 21.5 48 48v48H0V112C0 85.5 21.5 64 48 64H96V32c0-17.7 14.3-32 32-32zM0 192H448V464c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V192zm64 80v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V272c0-8.8-7.2-16-16-16H80c-8.8 0-16 7.2-16 16zm128 0v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V272c0-8.8-7.2-16-16-16H208c-8.8 0-16 7.2-16 16zm144-16c-8.8 0-16 7.2-16 16v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V272c0-8.8-7.2-16-16-16H336zM64 400v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V400c0-8.8-7.2-16-16-16H80c-8.8 0-16 7.2-16 16zm144-16c-8.8 0-16 7.2-16 16v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V400c0-8.8-7.2-16-16-16H208zm112 16v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V400c0-8.8-7.2-16-16-16H336c-8.8 0-16 7.2-16 16z"
									stroke="currentColor"
								/>
							</svg>
							<span>
								Created on:{" "}
								<time datetime={creationDate.toISOString()}>
									{displayDate}
								</time>
							</span>
						</div>
					</>
				)
			}
			{
				teamSize && (
					<>
						<div class="flex items-center">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								fill="currentColor"
								class="mr-2"
								viewBox="0 0 640 512"
							>
								<path d="M144 0a80 80 0 1 1 0 160A80 80 0 1 1 144 0zM512 0a80 80 0 1 1 0 160A80 80 0 1 1 512 0zM0 298.7C0 239.8 47.8 192 106.7 192h42.7c15.9 0 31 3.5 44.6 9.7c-1.3 7.2-1.9 14.7-1.9 22.3c0 38.2 16.8 72.5 43.3 96c-.2 0-.4 0-.7 0H21.3C9.6 320 0 310.4 0 298.7zM405.3 320c-.2 0-.4 0-.7 0c26.6-23.5 43.3-57.8 43.3-96c0-7.6-.7-15-1.9-22.3c13.6-6.3 28.7-9.7 44.6-9.7h42.7C592.2 192 640 239.8 640 298.7c0 11.8-9.6 21.3-21.3 21.3H405.3zM224 224a96 96 0 1 1 192 0 96 96 0 1 1 -192 0zM128 485.3C128 411.7 187.7 352 261.3 352H378.7C452.3 352 512 411.7 512 485.3c0 14.7-11.9 26.7-26.7 26.7H154.7c-14.7 0-26.7-11.9-26.7-26.7z" />
							</svg>
							<span>Team Size: {teamSize}</span>
						</div>
					</>
				)
			}
			{
				timeFrame && (
					<>
						<div class="flex items-center">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								fill="currentColor"
								class="mr-2"
								viewBox="0 0 512 512"
							>
								<path d="M256 0a256 256 0 1 1 0 512A256 256 0 1 1 256 0zM232 120V256c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2V120c0-13.3-10.7-24-24-24s-24 10.7-24 24z" />
							</svg>
							<span>Time Frame: {timeFrame}</span>
						</div>
					</>
				)
			}
			{
				toolUsed && (
					<>
						<div class="flex items-center">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								fill="currentColor"
								class="mr-2"
								viewBox="0 0 512 512"
							>
								<path d="M78.6 5C69.1-2.4 55.6-1.5 47 7L7 47c-8.5 8.5-9.4 22-2.1 31.6l80 104c4.5 5.9 11.6 9.4 19 9.4h54.1l109 109c-14.7 29-10 65.4 14.3 89.6l112 112c12.5 12.5 32.8 12.5 45.3 0l64-64c12.5-12.5 12.5-32.8 0-45.3l-112-112c-24.2-24.2-60.6-29-89.6-14.3l-109-109V104c0-7.5-3.5-14.5-9.4-19L78.6 5zM19.9 396.1C7.2 408.8 0 426.1 0 444.1C0 481.6 30.4 512 67.9 512c18 0 35.3-7.2 48-19.9L233.7 374.3c-7.8-20.9-9-43.6-3.6-65.1l-61.7-61.7L19.9 396.1zM512 144c0-10.5-1.1-20.7-3.2-30.5c-2.4-11.2-16.1-14.1-24.2-6l-63.9 63.9c-3 3-7.1 4.7-11.3 4.7H352c-8.8 0-16-7.2-16-16V102.6c0-4.2 1.7-8.3 4.7-11.3l63.9-63.9c8.1-8.1 5.2-21.8-6-24.2C388.7 1.1 378.5 0 368 0C288.5 0 224 64.5 224 144l0 .8 85.3 85.3c36-9.1 75.8 .5 104 28.7L429 274.5c49-23 83-72.8 83-130.5zM56 432a24 24 0 1 1 48 0 24 24 0 1 1 -48 0z" />
							</svg>
							<span>Tool Used: {toolUsed}</span>
						</div>
					</>
				)
			}
      <div class="divider my-2"></div>
      <slot />
    </article>

  </main>

<script type="module">
const content = document.getElementById('post-content');
const toc = document.querySelector('#toc ul');
const headings = content?.querySelectorAll('h2, h3');

// Simple slugify function to create safe IDs
function slugify(text) {
  return text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')   // remove special chars
    .replace(/\s+/g, '-')       // spaces → dashes
    .replace(/^-+/, '');        // no leading dashes
}

// Ensure headings have valid IDs
headings?.forEach(h => {
  let rawId = h.id || slugify(h.textContent);
  if (/^\d/.test(rawId)) rawId = '_' + rawId;
  h.id = rawId;
});

// Build TOC
headings?.forEach(h => 
{
  if (h.tagName.toLowerCase() === 'h2') 
{
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = '#' + h.id;
    a.textContent = h.textContent;
    a.classList.add('h2');
    li.appendChild(a);

    // container for h3 children
    const subUl = document.createElement('ul');
    subUl.classList.add('sub-toc', 'hidden'); // start hidden
    li.appendChild(subUl);

    toc?.appendChild(li);
	} else if (h.tagName.toLowerCase() === 'h3') {
		const lastH2 = toc?.querySelector('li:last-child ul.sub-toc');
		if (lastH2) 
			{
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = '#' + h.id;
				a.textContent = h.textContent;
				a.classList.add('h3');
				li.appendChild(a);
				lastH2.appendChild(li);
			}
		}
});

const tocLinks = document.querySelectorAll('#toc a');
const headingArray = Array.from(headings); // easier indexing
let currentH2Index = -1;

// Dynamically compute scroll offset for sticky navs
function getScrollOffset() {
  let offset = 0;
  const mainNav = document.querySelector('.sticky.lg\\:hidden.top-0');
  if (mainNav) offset += mainNav.offsetHeight;
  const tocBar = document.getElementById('toc');
  if (tocBar && window.innerWidth <= 1023) offset += tocBar.offsetHeight;
  return offset || 0;
}

// Update TOC highlighting and sub-toc visibility
function updateTOC() {
  const offset = getScrollOffset();
  let currentH2Index = -1;
  let currentH3Id = null;

  headingArray.forEach((h, idx) => {
    const rect = h.getBoundingClientRect();
    if (h.tagName.toLowerCase() === 'h2' && rect.top - offset <= 0) {
      currentH2Index = idx;
    }
    if (h.tagName.toLowerCase() === 'h3' && rect.top - offset <= 0) {
      currentH3Id = h.id;
    }
  });

  // Highlight h2
  headingArray.forEach(h => {
    const link = document.querySelector(`#toc a[href="#${h.id}"]`);
    if (!link) return;

    if (h.tagName.toLowerCase() === 'h2') {
      link.classList.toggle('active', headingArray[currentH2Index] === h);
      const subToc = link.parentElement?.querySelector('.sub-toc');
      if (subToc) {
        subToc.classList.toggle('hidden', headingArray[currentH2Index] !== h);
      }
    }

    if (h.tagName.toLowerCase() === 'h3') {
      link.classList.toggle('active', h.id === currentH3Id);
    }
  });
}

window.addEventListener('scroll', updateTOC);
window.addEventListener('resize', updateTOC);
updateTOC(); // Initial call

// Scroll listener to detect current h2
window.addEventListener('scroll', () => {
  let lastVisibleH2Index = -1;
  const offset = getScrollOffset();

  headingArray.forEach((h, idx) => {
    if (h.tagName.toLowerCase() === 'h2') {
      const rect = h.getBoundingClientRect();
      if (rect.top - offset <= 0) lastVisibleH2Index = idx;
    }
  });

  if (lastVisibleH2Index !== currentH2Index) {
    currentH2Index = lastVisibleH2Index;
    updateTOC();
  }
});

// Smooth scroll when clicking TOC links
tocLinks.forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const target = document.querySelector(link.getAttribute('href'));
    if (!target) return;
    const offset = getScrollOffset();
    const top = target.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top, behavior: 'smooth' });
  });
});

// TOC toggle button (collapse/expand)
const tocNav = document.getElementById('toc');
const tocToggle = document.getElementById('toc-toggle');
const savedState = localStorage.getItem('toc-collapsed');
if (savedState === 'true') {
  tocNav?.classList.add('collapsed');
  tocToggle.textContent = '📕';
}

tocToggle?.addEventListener('click', () => {
  tocNav?.classList.toggle('collapsed');
  const isCollapsed = tocNav.classList.contains('collapsed');
  tocToggle.textContent = isCollapsed ? '📕' : '📖';
  localStorage.setItem('toc-collapsed', isCollapsed);
});
</script>

<style is:global>

	.toc-layout {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
}

article {
  flex: 1;
  min-width: 0;
  order: 1;
}

#toc {
  position: sticky;
  top: 1rem;
  max-width: 250px;
  padding: 1rem;
  border: 2px solid var(--border-color, #eee);
  border-radius: 0.25rem;
  background-color: var(--p, var(--b1)); /* use site background */
  color: inherit; /* inherit text color */
  flex-shrink: 0;
  order: 2;
  align-self: flex-start;
}

/* Links */
#toc a {
  display: block;
  padding: 0.2rem 0.4rem;
  text-decoration: none;
  color: inherit;
  border-radius: 0.25rem;
  transition: background-color 0.2s, color 0.2s;
}

#toc a.active {
  color: var(--pc); /* primary content color, usually white */
  background-color: var(--p); /* primary background */
  font-weight: bold;
  border-radius: 0.25rem;
  padding: 0.25rem 0.5rem;
}

/* Nested h3 links */
#toc a.h3 {
  padding-left: 1rem;
  font-size: 0.9rem;
}

.sub-toc {
  margin-left: 1rem;
}
.sub-toc.hidden {
  display: none;
}


/* Mobile adjustments */
@media (max-width: 1023px) {
  #toc {
    width: 100%;
    max-width: 100%;
    order: 0;
    margin-bottom: 0.5rem;
    padding: 0.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    top: 4rem; /* below your header h-16 (64px) */

    /* replicate navbar styles */
    background-color: var(--fallback-b1, oklch(var(--b1) / var(--tw-bg-opacity)));
    --tw-bg-opacity: 0.9;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.1s ease-in-out;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
    z-index: 20; /* so it sits above article content */
  }

  #toc small {
    display: none;
  }

  #toc ul {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
    list-style: none;
    gap: 0.5rem;
  }

   #toc li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  #toc a {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
    white-space: normal;
    word-break: break-word;
  }

    #toc a.h3 {
    font-size: 0.8rem;
    padding: 0.2rem 0.4rem;
  }

    .sub-toc {
    display: flex;              /* inline layout */
    flex-wrap: wrap;            /* wrap if overflow */
    gap: 0.5rem;
    margin-left: 0;             /* no indent on mobile */
    width: 100%;                /* full width row */
  }

  .sub-toc.hidden {
    display: none !important;   /* keep hidden when collapsed */
  }

    #toc .toc-header small {
    display: inline-block;        /* show on mobile */
    font-size: 0.85rem;
    /* font-weight: bold; */
    margin-left: 0.5rem;          /* space after button */
  }

  #toc .toc-header button {
    order: 0;                      /* keep toggle first */
  }

  #toc .toc-header small {
    order: 1;                      /* title appears after button */
  }
}

.toc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

#toc-toggle {
  border: none;
  background: none;
  font-size: 1.2rem;
  cursor: pointer;
  line-height: 1;
  padding: 0.2rem 0.4rem;
  border-radius: 0.25rem;
  transition: background 0.2s;
}

#toc-toggle:hover {
  background: rgba(0,0,0,0.05);
}

/* When collapsed, hide the TOC list */
#toc.collapsed ul {
  display: none;
}
</style>

</BaseLayout>


