---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import Button from "../components/Button.astro";
---

<style>
  a {
    text-decoration: underline;
  }
</style>

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="flex justify-center">
    <Button href="/pdf/Samuel_Styles_CV.pdf">PDF Version</Button>
  </div>
  &nbsp;

<!-- SKILLS -->

  <div class="mb-5">
      <div class="text-3xl w-full font-bold">Skills</div>
    </div>
    <ul class="list-disc md:columns-5 columns-2 mx-6">
      <li>x86_64 ASM</li>
      <li>SIMD</li>
      <li>C++</li>
      <li>C#</li>
      <li>GLSL</li>
      <li>HLSL</li>
      <li>Python</li>
      <li>SQL</li>
      <li>HTML</li>
      <li>CSS</li>
    </ul>
    &nbsp;
    <ul class="list-disc md:columns-5 columns-2 mx-6">
      <li>Unity</li>
      <li>Shader Graph</li>
      <li>Git</li>
      <li>Unreal Engine</li>
      <li>Material System</li>
      <li>Perforce</li>
      <li>OpenGL</li>
      <li>Trello</li>
      <li>Miro</li>
      <li>Adobe After Effect</li>
      <li>Office Suite</li>
    </ul>
    &nbsp;

    <!-- <div class="mb-5">
      <div class="text-3xl w-full font-bold">Soft Skills</div>
    </div>
    <ul class="list-disc md:columns-5 columns-2 mx-6">
      <li>Adaptability</li>
      <li>Empathy</li>
      <li>Collaboration</li>
      <li>Communication</li>
      <li>Conflict resolution</li>
      <li>Creativity</li>
      <li>Leadership</li>
      <li>Open-mindedness</li>
