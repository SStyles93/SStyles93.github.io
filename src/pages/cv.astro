---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import Button from "../components/Button.astro";
import { skillLanguages, skillEngines, skillSoftware, experiences, certifications } from "../data/cv";
---

<style>
  a {
    text-decoration: underline;
  }
</style>

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="flex justify-center mb-5">
    <Button href="/pdf/Samuel_Styles_CV.pdf">PDF Version</Button>
  </div>

  <!-- EXPERIENCE -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Work Experiences</div>
  </div>
  <div class="time-line-container grid gap-4 mb-10">
    {experiences.map((exp) => (
      <TimeLineElement title={exp.title} subtitle={exp.subtitle}>
        {exp.bulletGroups.map((group, i) => (
          <ul class={`list-disc mx-6${i > 0 ? " mt-2" : ""}`}>
            {group.map((bullet) => <li>{bullet}</li>)}
          </ul>
        ))}
      </TimeLineElement>
    ))}
  </div>

  <!-- SKILLS -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>
  <ul class="list-disc md:columns-5 columns-2 mx-6">
    {skillLanguages.map((s) => <li>{s}</li>)}
  </ul>
  &nbsp;
  <ul class="list-disc md:columns-5 columns-2 mx-6">
    {[...skillEngines, ...skillSoftware].map((s) => <li>{s}</li>)}
  </ul>
  &nbsp;

  <!-- LANGUAGES -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Languages</div>
  </div>
  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>French (Native)</li>
    <li>English (Native)</li>
    <li>Italian (B1)</li>
    <li>German <br />(basic knowledge)</li>
  </ul>
  &nbsp;

  <!-- CERTIFICATIONS -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>
  <div class="time-line-container grid gap-4 mb-10">
    {certifications.map((cert) => (
      <TimeLineElement title={cert.title} subtitle={cert.subtitle}>
        <Button href={cert.pdfPath}>{cert.buttonLabel}</Button>
      </TimeLineElement>
    ))}
  </div>
</BaseLayout>
