---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SocialShare from "../../components/SocialShare.astro";
import type { BlogSchema } from "../../content/config";
import { getCollection, render } from "astro:content";
import dayjs from "dayjs";

interface Pages {
  data: BlogSchema[];
}

export async function getStaticPaths({ paginate }) {
  const blogs = await getCollection("blogs");

  blogs.sort((a: BlogSchema, b: BlogSchema) => {
    if (a.data.order === b.data.order) {
      return dayjs(b.data.creationDate).valueOf() - dayjs(a.data.creationDate).valueOf();
    }
    return a.data.order - b.data.order;
  });

  return paginate(blogs, { pageSize: 10 });
}

interface Props {
  page: Pages;
}

const { page } = Astro.props;
---

<BaseLayout title="Blog">
  <div class="text-3xl w-full font-bold mb-5">Posts</div>

  <ul class="space-y-12">
    {await Promise.all(
      page.data.map(async (blog: BlogSchema) => {
        const { Content } = await render(blog);
        const isProject = blog.data.isProject === true;

        return (
<li class="border rounded-xl shadow p-4 sm:p-6 prose max-w-none flex flex-col">
  {/* Main content area */}
  <div class="flex-grow">
    <h2 class="text-2xl font-bold mb-4">{blog.data.title}</h2>

    <div class={isProject ? "" : "mdx-preview"}>
      <Content />
    </div>

    {!isProject ? (
      <>
        <div class="flex justify-center my-5 preview-only">
          <Button href={`/blogs/${blog.slug}/`}>Read More</Button>
        </div>
        <div class="my-5 flex justify-center">
          <SocialShare
            title={blog.data.title}
            description={blog.data.description}
            url={Astro.url.origin + `/blogs/${blog.slug}/`}
          />
        </div>
      </>
    ) : null}
  </div>

  <div class="text-sm text-gray-500 mt-auto text-center pt-4">
    Created on {dayjs(blog.data.creationDate).format("MMMM YYYY")}
  </div>
</li>
        );
      })
    )}
  </ul>

  <nav class="flex justify-between mt-12">
    {page.url.prev ? <Button href={page.url.prev}>← Previous</Button> : <span />}
    {page.url.next ? <Button href={page.url.next}>Next →</Button> : <span />}
  </nav>

  <style is:global>
    /* Truncate everything after the 5th child (paragraph, heading, image, etc.) */
    .mdx-preview > *:nth-child(n+5) {
      display: none;
    }

    /* Optional: add some spacing for the preview-only controls */
    .preview-only {
      margin-top: 1rem;
    }
  </style>
</BaseLayout>
