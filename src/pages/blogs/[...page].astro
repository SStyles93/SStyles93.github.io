---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import type { BlogSchema } from "../../content/config";
import { getCollection } from "astro:content";
import dayjs from "dayjs";

interface Pages {
	data: BlogSchema[];
}

export async function getStaticPaths({ paginate }) {
	const blogs = await getCollection("blogs");
	return paginate(blogs, { pageSize: 10 });
}

interface Props {
	page: Pages;
}

const { page } = Astro.props;

page.data.sort((a: BlogSchema, b: BlogSchema) => {
	if (a.data.order === b.data.order) {
		const aDate = dayjs(a.data.creationDate);
		const bDate = dayjs(b.data.creationDate);
		return bDate - aDate;
	}
	return a.data.order - b.data.order;
});
---

<BaseLayout title="Blog">
	<div>
		<div class="text-3xl w-full font-bold mb-5">Posts</div>
	</div>

	<ul>
		{
			page.data.sort().map((blog: BlogSchema) => (
				<>
					<HorizontalCard
						title={blog.data.title}
						img={blog.data.heroImage}
						desc={blog.data.description}
						url={"/blogs/" + blog.slug}
						target="_self"
						teamSize={blog.data.teamSize}
						timeFrame={blog.data.timeFrame}
						toolUsed={blog.data.toolUsed}
						creationDate={dayjs(blog.data.creationDate).format(
							"MMMM YYYY",
						)}
					/>
					<div class="divider my-0" />
				</>
			))
		}
	</ul>
</BaseLayout>
