---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import type { BlogSchema } from "../../content/config";
import { getCollection } from "astro:content";
import dayjs from "dayjs";

interface Pages {
	data: BlogSchema[];
}

export async function getStaticPaths({ paginate }) {
	const blogs = await getCollection("blogs");
	return paginate(blogs, { pageSize: 10 });
}

interface Props {
	page: Pages;
}

const { page } = Astro.props;

page.data.sort((a: BlogSchema, b: BlogSchema) => {
	if (a.data.order === b.data.order) {
		const aDate = dayjs(a.data.creationDate);
		const bDate = dayjs(b.data.creationDate);
		return bDate - aDate;
	}
	return a.data.order - b.data.order;
});
---

<BaseLayout title="Blogs">
	<div>
		<div class="text-3xl w-full font-bold mb-5">Blogs</div>
	</div>

	<ul>
		{
			page.data.sort().map((blogs: BlogSchema) => (
				<>
					<BlogCard
						title={blogs.data.title}
						img={blogs.data.heroImage}
						desc={blogs.data.description}
						url={"/blogs/" + blogs.slug}
						target="_self"
						creationDate={dayjs(blogs.data.creationDate).format(
							"MMMM YYYY",
						)}
					/>
					<div class="divider my-0" />
				</>
			))
		}
	</ul>
</BaseLayout>
