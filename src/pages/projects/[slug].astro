---
import { getCollection, render } from "astro:content";
import type { ProjectSchema } from "../../content/config";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import Hr from "../../components/Hr.astro";
import MdImage from "../../components/MdImage.astro";
import ArticleCard from "../../components/content/ArticleCard.astro";
import { getArticles } from "../../utils/content";

export async function getStaticPaths() {
	const projectEntries = await getCollection("projects");
	return projectEntries.map((entry) => ({
		params: { slug: entry.id.toLowerCase() },
		props: { entry },
	}));
}

interface Props {
	entry: ProjectSchema;
}

const { entry } = Astro.props;
const project = entry.data;
const { Content } = await render(entry);
const relatedArticles = (await getArticles())
	.filter((post) => post.data.project === entry.id)
	.sort((a, b) => (a.data.series?.part ?? 0) - (b.data.series?.part ?? 0));
---

<ProjectLayout
	title={project.title}
	description={project.description}
	creationDate={project.creationDate}
	order={project.order}
	heroImage={project.heroImage}
	teamSize={project.teamSize}
	timeFrame={project.timeFrame}
	toolUsed={project.toolUsed}
	category={project.category}
	tags={project.tags}
>
	<Content components={{ hr: Hr, img: MdImage }} />

	{relatedArticles.length > 0 && (
		<section class="not-prose mt-12">
			<h2 class="text-2xl font-bold mb-3">Related articles</h2>
			<ul class="grid gap-1">
				{relatedArticles.map((post) => <ArticleCard post={post} />)}
			</ul>
		</section>
	)}
</ProjectLayout>
