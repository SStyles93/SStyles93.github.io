---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import Button from "../components/Button.astro";

const projects = (await getCollection("projects"))
	.filter((project) => project.data.pinned)
	.sort((a, b) => {
		if (a.data.order === b.data.order) {
			const aDate = dayjs(a.data.creationDate);
			const bDate = dayjs(b.data.creationDate);
			return bDate - aDate;
		}
		return a.data.order - b.data.order;
	});
const MAX_PROJECTS = 5;
const shownProjects = projects.slice(0, MAX_PROJECTS);
// const lastProject = projects[MAX_PROJECTS - 1];
---

<BaseLayout sideBarActiveItemID="home">
	<div class="pb-12 mt-5">
		<div class="text-xl py-1">Hey there 👋</div>
		<div class="text-5xl">I'm <b>Samuel Styles</b></div>
		<div class="text-3xl py-3">
			a <b>Software Engineer</b> | <b>Game Developper</b>!
		</div>
		<div class="py-2">
			<text class="text-lg">

				As a passionate game programmer, I work as much as possible with artists, enabling me to combine my love for both technology and creativity. 
				<br>
				<br>I hold a bachelor's degree in Science, graduating with first-class honors, which has equipped me with solid technical skills.
				<br>I have a broad interest in digital art, ranging from 2D to 3D, as well as game design, 
				allowing me to approach game development from a multidisciplinary perspective. 
				<br>
				<br>My goal is to create immersive, visually striking experiences by blending art and code.

				<!-- I obtained a First with Honours <b>Bachelor's degree in Science</b> 
				<br>from the <a href="https://www.herts.ac.uk/"><b><u>University of Hertfordshire</u></b> 
					via the <a href="https://www.sae.edu/ch-ge/"><b><u>SAE-Institute</u></b> in Geneva </a>
					<br>and I am currently working on other projects on the side.<br /> -->
			</text>
		</div>
		<!-- <br /> -->
		<!-- <div class="text-2xl w-full mb-2">
			<b>Use these buttons to Discover my work</b>
		</div>
		<br />
		<div class="flex">
			<Button href="https://SStyles93.github.io/projects">
				Projects
			</Button>
			<Button href="https://SStyles93.github.io/blogs">Blog</Button>
			<Button href="https://SStyles93.github.io/cv">CV</Button>
		</div> -->
	</div>
	<!-- <br /> -->
	<div>
		<div class="text-3xl w-full font-bold mb-2">Highlighted Projects</div>
	</div>
	{
		shownProjects.map((project) => (
			<>
				<HorizontalCard
					title={project.data.title}
					img={project.data.heroImage}
					desc={project.data.description}
					url={"/projects/" + project.slug}
					target="_self"
					teamSize={project.data.teamSize}
					timeFrame={project.data.timeFrame}
					toolUsed={project.data.toolUsed}
					creationDate={dayjs(project.data.creationDate).format(
						"MMMM YYYY",
					)}
				/>
				<div class="divider my-0" />
			</>
		))
	}

	<div class="mt-8">
		<a class="btn btn-outline ml-5" href="/projects">See all projects...</a>
	</div>
</BaseLayout>
