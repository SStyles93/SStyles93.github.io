---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import Button from "../components/Button.astro";
import SkillGrid from "../components/cv/SkillGrid.astro";
import { categories } from "../data/taxonomy";
import { countByCategory } from "../utils/content";
import { skillLanguages, skillEngines, skillTools, experiences } from "../data/cv";

const projects = (await getCollection("projects"))
	.filter((project) => project.data.pinned)
	.sort((a, b) => {
		if (a.data.order === b.data.order) {
			const aDate = dayjs(a.data.creationDate);
			const bDate = dayjs(b.data.creationDate);
			return bDate - aDate;
		}
		return a.data.order - b.data.order;
	});
const MAX_PROJECTS = 3;
const shownProjects = projects.slice(0, MAX_PROJECTS);
const latestExp = experiences[0];
const areas = await Promise.all(
	categories.map(async (category) => ({ ...category, ...(await countByCategory(category.id)) })),
);
// const lastProject = projects[MAX_PROJECTS - 1];
---

<BaseLayout sideBarActiveItemID="home">
	<link
		slot="head"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
	/>
	<div class="pb-12 mt-5">
		<div class="text-xl py-1">Hi,</div>
		<div class="text-5xl">I'm <b>Samuel Styles</b></div>
		<div class="text-3xl py-3">
			a <b>Software Engineer</b> & <b>Game Developper</b>!
		</div>
		<div class="py-2">
			<text class="text-lg">
				Software engineer specialized in C++ and C#, with a BSc (First Class Honours) and a background in industrial mechatronics.
				Experienced from low-level systems and native libraries to developer tooling and commercial products shipped 
				as co-founder and lead programmer. 
				C++ Institute and Unity certified. Looking for a software engineering role building reliable, high-performance systems.
			</text>
		</div>
	</div>

	<div class="divider my-2" />

	<div>
		<div class="text-3xl w-full font-bold mb-5">Tech Stack</div>

		<SkillGrid label="Languages" skills={skillLanguages} />
		<SkillGrid label="Frameworks &amp; Engines" skills={skillEngines} />
		<SkillGrid label="Tools" skills={skillTools} />
	</div>

	<div class="divider my-6" />

	<div>
		<div class="text-3xl w-full font-bold mb-4">Latest Experience</div>
		<div class="card bg-base-200 p-5">
			<div class="text-xl font-bold">{latestExp.title}</div>
			<div class="text-base opacity-70 mt-1">{[latestExp.company, latestExp.location].filter(Boolean).join(", ")} · {latestExp.start} – {latestExp.end}</div>
			<ul class="list-disc mx-6 mt-3 text-base [&_a]:underline [&_a]:text-primary">
				{latestExp.bullets.map((bullet) => (
					<li set:html={bullet} />
				))}
			</ul>
		</div>
		<div class="mt-4 flex justify-center">
			<Button href="/cv">View Full CV</Button>
		</div>
	</div>

	<div class="divider my-6" />

	<div>
		<div class="text-3xl w-full font-bold mb-4">Explore by Area</div>
		<div class="grid sm:grid-cols-2 gap-4">
			{areas.map((area) => (
				<a
					href={`/projects/category/${area.id}/`}
					class="card bg-base-200 hover:bg-base-300 transition-colors p-5"
				>
					<div class="text-lg font-bold">{area.label}</div>
					<p class="text-sm opacity-80 mt-1">{area.description}</p>
					<div class="text-xs uppercase tracking-widest opacity-60 mt-3">
						{area.projects} projects · {area.articles} articles
					</div>
				</a>
			))}
		</div>
	</div>

	<div class="divider my-6" />

	<div>
		<div class="text-3xl w-full font-bold mb-2">Highlighted Projects</div>
	</div>
	{
		shownProjects.map((project) => (
			<>
				<HorizontalCard
					title={project.data.title}
					img={project.data.heroImage}
					desc={project.data.description}
					url={"/projects/" + project.id.toLowerCase()}
					target="_self"
					teamSize={project.data.teamSize}
					timeFrame={project.data.timeFrame}
					toolUsed={project.data.toolUsed}
					creationDate={dayjs(project.data.creationDate).format(
						"MMMM YYYY",
					)}
				/>
				<div class="divider my-0" />
			</>
		))
	}

	<div class="mt-8 flex justify-center">
		<a class="btn btn-outline ml-5" href="/projects">See All Projects</a>
	</div>
</BaseLayout>
