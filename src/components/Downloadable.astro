---
// src/components/Downloadable.astro

export interface Props {
  /** The full URL to the file you want to link to. */
  url: string;
  /** (Optional) The name you want the file to be saved as. 
      If not provided, the browser will use the filename from the URL. */
  fileName?: string;
}

const { url, fileName } = Astro.props;

// Determine the text to display on the button.
// It will try to extract a filename from the URL if no explicit fileName is given.
const getFileNameFromUrl = (url: string) => {
  try {
    const path = new URL(url).pathname;
    return path.substring(path.lastIndexOf('/') + 1);
  } catch (e) {
    // If the URL is invalid or parsing fails, fall back to a generic name
    return "file";
  }
};

const buttonText = fileName || getFileNameFromUrl(url);
---
<div class="flex justify-center">
<a 
href={url} 
download={fileName} 
class="download-button" 
target="_blank" 
rel="noopener noreferrer">
  Download "{buttonText}"
</a>
</div>

<style>
  .download-button {
    display: inline-block;
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 12px 24px;
    background-color: #1e90ff;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
    text-align: center;
    transition: background-color 0.3s ease;
  }
  .download-button:hover {
    background-color: #0073e6;
  }
</style>


