---
// src/components/ImageGallery.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
    images: string[];
    galleryName?: string;
    containerClasses?: string;
    imageClasses?: string;
}

const {
    images: imagePaths = [],
    galleryName = `gallery-${Math.random().toString(36).substring(2, 9)}`,
    containerClasses = "flex flex-wrap justify-center gap-4",
    imageClasses = "w-72 h-auto cursor-pointer rounded-lg shadow-md transition-shadow hover:shadow-xl",
} = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"
);

for (const path of imagePaths) {
    if (!allImages[path]) {
        throw new Error(
            `[ImageGallery] The image "${path}" was not found. Make sure it exists in "/src/assets/".`
        );
    }
}
---

<!-- 
  The 'client:load' directive ensures this component and its script are loaded
  and executed immediately in the browser.
-->
<div client:load>
    <div class:list={containerClasses}>
        {
            imagePaths.map(async (path) => {
                const imageModule = await allImages[path]();
                return (
                    <a
                        href={imageModule.default.src}
                        class="glightbox"
                        data-gallery={galleryName}
                    >
                        <Image
                            src={imageModule.default}
                            alt="Project screenshot"
                            class={imageClasses}
                            loading="lazy"
                        />
                    </a>
                );
            })
        }
    </div>

    <!-- 
      This inline script will run as soon as the component is loaded on the page.
      It dynamically loads the Glightbox library and its CSS, then initializes it.
    -->
    <script is:inline>
        // We wrap everything in an IIFE to avoid polluting the global scope.
        (() => {
            // Dynamically create and inject the Glightbox CSS file into the <head>.
            const cssLink = document.createElement('link');
            cssLink.rel = 'stylesheet';
            cssLink.href = '/node_modules/glightbox/dist/css/glightbox.min.css'; // Adjust path if needed
            document.head.appendChild(cssLink);

            // Dynamically create and inject the Glightbox JS library.
            const script = document.createElement('script');
            script.src = '/node_modules/glightbox/dist/js/glightbox.min.js'; // Adjust path if needed
            script.async = true;

            // When the script has finished loading, initialize Glightbox.
            script.onload = () => {
                if (typeof GLightbox === 'function') {
                    const lightbox = GLightbox({
                        loop: true,
                        touchNavigation: true,
                    });
                }
            };
            
            document.body.appendChild(script);
        })();
    </script>
</div>
