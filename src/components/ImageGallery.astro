---
// src/components/ImageGallery.astro

import "glightbox/dist/css/glightbox.min.css";

export interface Props {
  images: string[];
  galleryName?: string;
  containerClasses?: string;
  imageClasses?: string;
}

const {
  images: imagePaths = [],
  galleryName = `gallery-${Math.random().toString(36).substring(2, 9)}`,
  containerClasses = "flex flex-wrap justify-center gap-4",
  imageClasses = "w-72 h-auto cursor-pointer rounded-lg shadow-md transition-shadow hover:shadow-xl",
} = Astro.props;

// This server-side logic finds and resolves the image paths you provide.
const allImageModules = await import.meta.glob<{ default: { src: string } }>(
  "/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}"
);

const resolvedImages = await Promise.all(
  imagePaths.map(async (path) => {
    const normalizedPath = path.startsWith('/') ? path : `/${path}`;
    const importFunc = allImageModules[normalizedPath];

    if (!importFunc) {
      throw new Error(`[ImageGallery] Image not found at path: ${normalizedPath}.`);
    }

    const module = await importFunc();
    
    return {
      src: module.default.src,
      alt: normalizedPath.split('/').pop()?.replace(/\.[^/.]+$/, "") || "Gallery image"
    };
  })
);
---

<div client:visible>
  <div class:list={containerClasses}>
    {resolvedImages.map((image) => (
      <a
        href={image.src}
        class="glightbox"
        data-gallery={galleryName}
        aria-label={`View image ${image.alt}`}
      >
        <img
          src={image.src}
          alt={image.alt}
          class:list={imageClasses}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))}
  </div>

  <script is:inline>
    // This inline script runs on the client-side.
    (() => {
      // Function to load an external script and return a promise.
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          // Check if the script is already on the page to avoid loading it multiple times.
          if (document.querySelector(`script[src="${src}"]`)) {
            resolve();
            return;
          }
          const script = document.createElement('script');
          script.src = src;
          script.onload = () => resolve();
          script.onerror = () => reject(new Error(`Script load error for ${src}`));
          document.head.appendChild(script);
        });
      }

      // Main logic to set up the gallery.
      async function setupGallery() {
        try {
          // ✅ **THE FIX IS HERE:**
          // We now point to the correct path inside your `public/scripts/` folder.
          await loadScript('/scripts/glightbox.min.js');
          
          // Once the script is loaded, GLightbox() will be available.
          if (typeof GLightbox === "function") {
            GLightbox({
              loop: true,
              touchNavigation: true,
            });
          } else {
            console.error("GLightbox function not found even after attempting to load the script.");
          }
        } catch (error) {
          console.error("Failed to load GLightbox script from /scripts/glightbox.min.js:", error);
        }
      }

      // Use the 'astro:page-load' event to ensure this runs on every page navigation.
      document.addEventListener('astro:page-load', setupGallery);
    })();
  </script>
</div>
