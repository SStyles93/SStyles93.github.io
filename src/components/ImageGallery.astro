---
// src/components/ImageGallery.astro

import { Image } from 'astro:assets';

// Define the props the component will accept.
// It expects an array of image paths (strings).
interface Props {
  images: string[];
}

// Get the images array from the component's props.
const { images } = Astro.props;

// Create a unique ID for this gallery instance. This is crucial
// for ensuring that clicking an image in one gallery doesn't
// open images from another gallery on the same page.
const galleryId = `gallery-${crypto.randomUUID()}`;

// GLightbox works by finding anchor tags (<a>) with a specific class.
// We will use this unique ID to create a unique selector for GLightbox.
const lightboxSelector = `.glightbox-${galleryId}`;
---

<!-- 
  This section renders the grid of thumbnail images.
  We use Astro's class:list directive to apply Tailwind CSS classes for styling.
-->
<div class:list={["grid grid-cols-2 md:grid-cols-3 gap-4"]}>
  {
    images.map((src) => (
      <a
        href={src}
        class={`glightbox ${lightboxSelector.substring(1)}`}
        data-gallery={galleryId}
      >
        <Image
          src={import(/* @vite-ignore */ src)}
          alt="Gallery image"
          class="h-auto max-w-full rounded-lg hover:opacity-90 transition-opacity"
          width={400}
          height={300}
        />
      </a>
    ))
  }
</div>

<!-- 
  This <script> tag contains the client-side JavaScript needed to initialize GLightbox.
  It's essential because GLightbox manipulates the DOM after the page has loaded.
-->
<script>
  // Import GLightbox and its CSS. The CSS is required for the lightbox to look correct.
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  // This function initializes GLightbox on a specific selector.
  // It's designed to be called for each gallery on the page.
  function initializeLightbox(selector: string) {
    GLightbox({
      selector: selector, // The unique class for this gallery's links
      touchNavigation: true,
      loop: true,
      autoplayVideos: true,
    });
  }

  // Find all unique gallery selectors on the current page.
  // We use a Set to avoid initializing the same gallery multiple times.
  const gallerySelectors = new Set<string>();
  document.querySelectorAll("[data-gallery]").forEach((el) => {
    const galleryId = (el as HTMLElement).dataset.gallery;
    if (galleryId) {
      gallerySelectors.add(`.glightbox-${galleryId}`);
    }
  });

  // Initialize GLightbox for each unique gallery found.
  gallerySelectors.forEach((selector) => {
    initializeLightbox(selector);
  });
</script>
