---
import "glightbox/dist/css/glightbox.css";

const { images = [] } = Astro.props;

// create a unique id for this gallery instance
const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="image-gallery grid grid-cols-2 gap-4">
  {images.map((img, idx) => {
    const src = typeof img === "string" ? img : img.src;
    return (
      <a
        href={src}
        class="glightbox"
        data-gallery={galleryId}
      >
        <img
          src={src}
          alt={`Gallery image ${idx + 1}`}
          class="rounded-lg shadow-md hover:opacity-80 transition"
        />
      </a>
    );
  })}
</div>

<script>
import GLightbox from "glightbox";

  function setupLightbox() {
    GLightbox({
      selector: '.glightbox',
      touchNavigation: true,
      loop: true,
      autoplayVideos: true,
    });
  }

  if (typeof window !== "undefined") {
    setupLightbox();
    document.addEventListener("astro:page-load", setupLightbox);
  }
</script>
