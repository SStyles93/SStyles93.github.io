---
// src/components/ImageGallery.astro
import { Image } from 'astro:assets';
import path from 'node:path';

// --- PROPS ---
// This component accepts an array of image file paths (strings).
interface Props {
  images: string[];
  class?: string;
}
const { images: imagePaths, class: className } = Astro.props;


// --- DATA FETCHING ---
// Use import.meta.glob to find and process all possible images at build time.
// This is the key to making string paths work reliably with Astro's <Image> component.
// The `{ eager: true }` option loads the image metadata immediately.
const allImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{png,jpg,jpeg,gif,webp,svg}',
  { eager: true }
);


// --- DATA PROCESSING ---
// Map the string paths you provide to the actual, processed image data.
const processedImages = imagePaths.map((imagePath) => {
  // Find the corresponding image module from the glob results.
  const imageModule = allImageModules[imagePath];

  // If an image path is incorrect, we'll log an error and skip it.
  if (!imageModule) {
    console.error(`[ImageGallery] Image not found at path: ${imagePath}. Please check the path in your component call.`);
    return null;
  }

  const image = imageModule.default;

  // Automatically generate a clean alt text from the filename.
  // e.g., "/path/to/Environment_01.png" -> "Environment 01"
  const filename = path.basename(image.src, path.extname(image.src)).split('.')[0];
  const altText = filename.replace(/[-_]/g, ' ');

  return {
    src: image,
    alt: altText,
  };
}).filter(Boolean); // The .filter(Boolean) removes any nulls from incorrect paths.


// --- SETUP ---
// Create a unique ID for each gallery to ensure they are isolated from each other.
const galleryId = `gallery-${crypto.randomUUID()}`;
const lightboxSelector = `.glightbox-${galleryId}`;
---

<!-- --- TEMPLATE --- -->
<div class:list={["grid grid-cols-2 md:grid-cols-3 gap-4", className]}>
  {
    processedImages.map((image) => (
      <a
        href={image.src.src}
        class={`glightbox ${lightboxSelector.substring(1)}`}
        data-gallery={galleryId}
        data-title={image.alt}
      >
        <Image
          src={image.src}
          alt={image.alt}
          widths={[240, 540, 720, 1080]}
          sizes="(max-width: 360px) 240px, (max-width: 720px) 540px, 720px"
          class="h-auto max-w-full rounded-lg object-cover aspect-square hover:opacity-90 transition-opacity"
        />
      </a>
    ))
  }
</div>


<!-- --- CLIENT-SIDE SCRIPT --- -->
<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  // This script finds all unique galleries on the page and initializes them.
  // It's designed to be efficient and run only once.
  const gallerySelectors = new Set<string>();
  document.querySelectorAll("[data-gallery]").forEach((el) => {
    const galleryId = (el as HTMLElement).dataset.gallery;
    if (galleryId) {
      gallerySelectors.add(`.glightbox-${galleryId}`);
    }
  });

  gallerySelectors.forEach((selector) => {
    GLightbox({
      selector: selector,
      touchNavigation: true,
      loop: true,
      autoplayVideos: true,
      titleAttribute: 'data-title',
    });
  });
</script>
