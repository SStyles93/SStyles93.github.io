---
import type { ImageMetadata } from 'astro';
import { Image } from "astro:assets";

interface Props {
    src: string;
    alt: string;
}

const {src, alt} = Astro.props as Props;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/**/*.{jpeg,jpg,png,gif,avif,webp}",
);
if (!images[src]) throw new Error(`"${src}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`);

---

<div data-lightbox="true">
	<Image
		src={images[src]()}
		widths={[240, 540, 720]}
		sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px`}
		alt={alt}
		class="w-full"
	/>
</div>

