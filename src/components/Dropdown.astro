---
// src/components/Dropdown.astro
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="dropdown-container">
  <button class="dropdown-button">
    {title}
    <svg class="dropdown-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <div class="dropdown-content hidden">
    <slot />
  </div>
</div>

<style>
  .dropdown-container {
    border: 1px solid hsl(0, 0%, 37%);
    border-radius: 8px;
    margin: 1rem 0;
  }

  .dropdown-button {
    width: 100%;
    background-color: #272727;
    color: #444;
    cursor: pointer;
    padding: 18px;
    text-align: left;
    border: none;
    outline: none;
    font-size: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 8px;
  }

  .dropdown-button:hover {
    background-color: #858585;
  }

  .dropdown-content {
    padding: 0 18px;
    background-color: rgb(68, 68, 68);
    overflow: hidden;
    transition: max-height 0.3s ease-out;
    max-height: 0;
  }

  .dropdown-content.hidden {
    display: none; /* Initially hide the content */
  }

  .dropdown-icon {
    transition: transform 0.3s ease;
  }

  .dropdown-container.open .dropdown-icon {
    transform: rotate(180deg );
  }
</style>

<script>
  document.querySelectorAll('.dropdown-button').forEach(button => {
    button.addEventListener('click', () => {
      const dropdownContainer = button.parentElement;
      const content = dropdownContainer.querySelector('.dropdown-content');
      
      // Toggle the 'open' class on the container
      dropdownContainer.classList.toggle('open');

      // Toggle visibility and animate the content
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        // Set max-height to its scroll height to animate opening
        content.style.maxHeight = content.scrollHeight + "px";
      } else {
        // Reset max-height to animate closing
        content.style.maxHeight = '0';
        // Hide the content after the transition ends
        content.addEventListener('transitionend', () => {
          content.classList.add('hidden');
        }, { once: true });
      }
    });
  });
</script>
