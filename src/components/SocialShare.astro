---

<div class="social-share-container" {...Astro.props}>
  {socialPlatforms.map(platform => (
    <a 
      href={platform.url} 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label={`Share on ${platform.name}`}
      class="social-icon-link"
    >
      <Fragment set:html={platform.icon} />
    </a>
   ))}
</div>

<style>
  /* --- Main Container and Default Icon Styles --- */
  .social-share-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .social-icon-link {
    display: inline-flex;
    /* Start with the default text color of your site */
    color: currentColor; 
    /* Smooth transition for both transform and color */
    transition: transform 0.2s ease, color 0.2s ease;
  }

  /* --- Global Hover and SVG Styles --- */
  .social-icon-link:hover {
    transform: scale(1.2); /* The icon grows on hover */
  }

  .social-icon-link :global(svg) {
    width: 26px;
    height: 26px;
  }

  /* --- Individual Brand Color Hovers --- */
  /* We use the 'aria-label' to target each specific link */

  .social-icon-link[aria-label="Share on LinkedIn"]:hover {
    color: #0077B5;
  }
  .social-icon-link[aria-label="Share on Reddit"]:hover {
    color: #FF4500;
  }
  .social-icon-link[aria-label="Share on Mastodon"]:hover {
    color: #6364FF;
  }
  .social-icon-link[aria-label="Share on Threads"]:hover {
    color: #000000;
  }
  .social-icon-link[aria-label="Share on Medium"]:hover {
    color: #000000;
  }
  .social-icon-link[aria-label="Share on Facebook"]:hover {
    color: #1877F2;
  }
  .social-icon-link[aria-label="Share on X"]:hover {
    color: #000000;
  }
  .social-icon-link[aria-label="Share on WhatsApp"]:hover {
    color: #25D366;
  }
  .social-icon-link[aria-label="Share on Email"]:hover {
    color: #c71515; /* A neutral gray for the email icon */
  }
</style>

