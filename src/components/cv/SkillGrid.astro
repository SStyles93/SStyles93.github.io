---
import type { SkillItem } from "../../data/cv";

const { label, skills } = Astro.props as { label: string; skills: SkillItem[] };
---

<div class="mb-2 text-xs font-semibold uppercase tracking-widest opacity-50">{label}</div>
<div class="flex flex-wrap gap-3 mb-6">
  {skills.map((skill) => (
    <div class="bg-base-200 hover:bg-base-300 transition-colors rounded-xl p-3 flex flex-col items-center gap-1 w-20">
      {skill.icon
        ? <i class={`${skill.icon} text-4xl`}></i>
        : skill.svgPath
          ? <svg viewBox="0 0 24 24" class="w-9 h-9 fill-current opacity-75" xmlns="http://www.w3.org/2000/svg"><path d={skill.svgPath} /></svg>
          : <span class="text-2xl font-mono font-bold opacity-40">&lt;/&gt;</span>
      }
      <span class="text-[11px] text-center leading-tight">{skill.name}</span>
    </div>
  ))}
</div>
