---
const { title, subtitle, date } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1"></span>
    <span
      class="education__line bg-primary block h-full w-[2px] translate-x-[7px]"
    ></span>
  </div>
  <div class="experience__data bd-grid px-5 w-full">
    <div class="flex flex-wrap justify-between gap-x-4">
      <h3 class="font-semibold mb-1">{title}</h3>
      {date && <span class="text-sm opacity-70 whitespace-nowrap">{date}</span>}
    </div>
    <span class="font-light text-sm italic">{subtitle}</span>
    <div class="my-2">
      <slot />
    </div>
  </div>
</div>
