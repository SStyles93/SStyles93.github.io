---
// CookieBanner.astro - Cookie consent banner with Google Analytics integration
---

<div id="cookie-banner" class="cookie-banner hidden">
  <div class="cookie-banner-content">
    <div class="cookie-banner-text">
      <h3>I use cookies 🍪</h3>
      <p>
        I use cookies to enhance browsing experience, analyze site traffic, and personalize content. 
        By clicking "Accept All", you consent to my use of cookies for analytics and portfolio improvement 🍪.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button id="cookie-accept-all" class="btn btn-primary">Accept All</button>
      <button id="cookie-accept-necessary" class="btn btn-secondary">Necessary Only</button>
      <button id="cookie-decline" class="btn btn-outline">Decline</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.95);
    color: white;
    padding: 1rem;
    z-index: 9999;
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateY(100%);
    transition: transform 0.3s ease-in-out;
  }

  .cookie-banner.show {
    transform: translateY(0);
  }

  .cookie-banner-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cookie-banner-text h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .cookie-banner-text p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    opacity: 0.9;
  }

  .cookie-banner-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: #3b82f6;
    color: white;
  }

  .btn-primary:hover {
    background: #2563eb;
  }

  .btn-secondary {
    background: #6b7280;
    color: white;
  }

  .btn-secondary:hover {
    background: #4b5563;
  }

  .btn-outline {
    background: transparent;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .cookie-banner-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .cookie-banner-actions {
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      flex: 1;
      min-width: 120px;
    }
  }

  /* Hide class */
  .hidden {
    display: none !important;
  }
</style>

<script>
  // Cookie banner functionality with Google Analytics integration
  class CookieBanner {
    constructor() {
      this.banner = document.getElementById('cookie-banner');
      this.acceptAllBtn = document.getElementById('cookie-accept-all');
      this.acceptNecessaryBtn = document.getElementById('cookie-accept-necessary');
      this.declineBtn = document.getElementById('cookie-decline');
      
      this.cookieName = 'cookie-consent';
      this.cookieExpiry = 365; // days
      
      this.init();
    }

    init() {
      // Check if user has already made a choice
      const consent = this.getCookie(this.cookieName);
      
      if (!consent) {
        // Show banner after a short delay
        setTimeout(() => {
          this.showBanner();
        }, 1000);
      } else {
        // Apply stored consent
        this.applyConsent(JSON.parse(consent));
      }

      // Bind event listeners
      this.bindEvents();
    }

    bindEvents() {
      if (this.acceptAllBtn) {
        this.acceptAllBtn.addEventListener('click', () => {
          this.handleAcceptAll();
        });
      }

      if (this.acceptNecessaryBtn) {
        this.acceptNecessaryBtn.addEventListener('click', () => {
          this.handleAcceptNecessary();
        });
      }

      if (this.declineBtn) {
        this.declineBtn.addEventListener('click', () => {
          this.handleDecline();
        });
      }
    }

    showBanner() {
      if (this.banner) {
        this.banner.classList.remove('hidden');
        // Trigger animation
        setTimeout(() => {
          this.banner.classList.add('show');
        }, 10);
      }
    }

    hideBanner() {
      if (this.banner) {
        this.banner.classList.remove('show');
        setTimeout(() => {
          this.banner.classList.add('hidden');
        }, 300);
      }
    }

    handleAcceptAll() {
      const consent = {
        necessary: true,
        analytics: true,
        marketing: true,
        timestamp: Date.now()
      };
      
      this.saveConsent(consent);
      this.applyConsent(consent);
      this.hideBanner();
      
      // Track consent acceptance
      this.trackConsentEvent('accept_all');
    }

    handleAcceptNecessary() {
      const consent = {
        necessary: true,
        analytics: false,
        marketing: false,
        timestamp: Date.now()
      };
      
      this.saveConsent(consent);
      this.applyConsent(consent);
      this.hideBanner();
      
      // Track consent acceptance
      this.trackConsentEvent('accept_necessary');
    }

    handleDecline() {
      const consent = {
        necessary: true,
        analytics: false,
        marketing: false,
        timestamp: Date.now()
      };
      
      this.saveConsent(consent);
      this.applyConsent(consent);
      this.hideBanner();
      
      // Track consent decline
      this.trackConsentEvent('decline');
    }

    applyConsent(consent) {
      // Update Google Analytics consent
      if (typeof window.updateGoogleAnalyticsConsent === 'function') {
        window.updateGoogleAnalyticsConsent({
          analytics_storage: consent.analytics ? 'granted' : 'denied',
          ad_storage: consent.marketing ? 'granted' : 'denied',
          ad_user_data: consent.marketing ? 'granted' : 'denied',
          ad_personalization: consent.marketing ? 'granted' : 'denied'
        });
      }

      // You can add other consent applications here
      // For example: enabling/disabling other tracking scripts
    }

    saveConsent(consent) {
      const consentString = JSON.stringify(consent);
      this.setCookie(this.cookieName, consentString, this.cookieExpiry);
    }

    trackConsentEvent(action) {
      // Track consent choice as an event
      if (typeof window.trackEvent === 'function') {
        window.trackEvent('cookie_consent', {
          event_category: 'consent',
          event_label: action,
          value: 1
        });
      }
    }

    // Cookie utility functions
    setCookie(name, value, days) {
      const expires = new Date();
      expires.setTime(expires.getTime() + (days * 24 * 60 * 60 * 1000));
      document.cookie = `${name}=${value};expires=${expires.toUTCString()};path=/;SameSite=Lax`;
    }

    getCookie(name) {
      const nameEQ = name + "=";
      const ca = document.cookie.split(';');
      for (let i = 0; i < ca.length; i++) {
        let c = ca[i];
        while (c.charAt(0) === ' ') c = c.substring(1, c.length);
        if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
      }
      return null;
    }

    // Public method to reset consent (for testing or user preference changes)
    resetConsent() {
      document.cookie = `${this.cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
      location.reload();
    }
  }

  // Initialize cookie banner when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new CookieBanner();
    });
  } else {
    new CookieBanner();
  }

  // Make reset function globally available for testing
  window.resetCookieConsent = function() {
    const banner = new CookieBanner();
    banner.resetConsent();
  };
</script>

