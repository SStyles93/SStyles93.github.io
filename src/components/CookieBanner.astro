---
const { GA_ID } = Astro.props;
---

<div client:load>
  <div id="cookie-banner" class="cookie-banner" style="display:none;">
    <p>
      I use cookies for analytics, this helps me improve my Portfolio.
      <br/><br/>
      Do you accept cookies? 🍪
    </p>
    <div class="buttons">
      <button id="accept-cookies">Accept</button>
      <button id="reject-cookies">Reject</button>
    </div>
  </div>

  <script is:inline>

    (() => {
      // Run only once per session
      if (window.__cookieBannerInitialized) return;
      window.__cookieBannerInitialized = true;

      const banner = document.getElementById("cookie-banner");
      if (!banner) return;

      const showBanner = () => {
        const consent = localStorage.getItem("analytics-consent");

        const GA_ID = "${GA_ID}";

        // Already accepted -> configure GA immediately
        if (consent === "granted") {
          if (GA_ID) {
            const waitForGtag = () => {
              if (typeof gtag === "function") {
                gtag('config', GA_ID);
                console.log("[CookieBanner] GA injected ✅");
              } else {
                setTimeout(waitForGtag, 50);
              }
            };
            waitForGtag();
          }
          banner.style.display = "none";
          return;
        }

        // Already declined -> hide banner, do NOT configure GA
        if (consent === "denied") {
          banner.style.display = "none";
          console.log("[CookieBanner] GA injection declined ❌");
          return;
        }

        // No consent yet -> show banner
        banner.style.display = "block";

        const acceptBtn = document.getElementById("accept-cookies");
        const rejectBtn = document.getElementById("reject-cookies");

        acceptBtn?.addEventListener("click", () => {
          localStorage.setItem("analytics-consent", "granted");
          banner.style.display = "none";

          // Configure GA after consent
          if (GA_ID) {
            const waitForGtag = () => {
              if (typeof gtag === "function") {
                gtag('config', GA_ID);
                console.log("[CookieBanner] GA injected ✅");
              } else {
                setTimeout(waitForGtag, 50);
              }
            };
            waitForGtag();
          }
        });

        rejectBtn?.addEventListener("click", () => {
          localStorage.setItem("analytics-consent", "denied");
          banner.style.display = "none";
          console.log("[CookieBanner] GA injection declined ❌");
        });
      };

      // Run on first load
      showBanner();

      // SPA navigation: re-run check
      document.addEventListener("astro:page-load", showBanner);
    })();
  </script>
</div>



  <style>
    .cookie-banner {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      max-width: 300px;
      background-color: var(--fallback-b1, oklch(var(--b1) / var(--tw-bg-opacity)));
      --tw-bg-opacity: 0.9;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: all 0.1s ease-in-out;
      padding: 1rem;
      border: 1px solid var(--border-color, #eee);
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      border-radius: 0.5rem;
      font-size: 14px;
      z-index: 1000;
    }
    .cookie-banner p {
      margin:0 0 0.5rem 0;
      color:#818181;
      font-size:14px;
    }
    .cookie-banner .buttons {
      display:flex;
      justify-content:flex-end;
      gap:0.5rem;
    }
    .cookie-banner button {
      padding:0.4rem 0.8rem;
      border:none;
      border-radius:4px;
      cursor:pointer;
      font-size:13px;
    }
    .cookie-banner button#accept-cookies {
      background: #1cd945;
      color: #fff;
      backdrop-filter: none;
    }
    .cookie-banner button#reject-cookies {
      background: rgb(209, 14, 14);
      color: #fff;
      backdrop-filter: none;
    }
  </style>
</div>
