<div client:load>
  <div id="cookie-banner" class="cookie-banner" style="display:none;">
    <p>I use cookies for analytics, this helps me improve my Portfolio.
      <br/>
      <br/> Do you accept my cookie ? 🍪</p>
      <br/>
    <div class="buttons">
      <button id="accept-cookies">Accept</button>
      <button id="reject-cookies">Reject</button>
    </div>
  </div>

  <script is:inline>
    (() => {
      const GA_ID = "G-55XW4V0S7F"; // your GA4 ID
      const banner = document.getElementById("cookie-banner");
      if (!banner) return;

      const injectGA = () => {
        if (window.__gaInjected) return;
        window.__gaInjected = true;

        // Load GA script via Partytown
        const gaScript = document.createElement("script");
        gaScript.type = "text/partytown";
        gaScript.async = true;
        gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(gaScript);

        // Configure GA
        const inlineScript = document.createElement("script");
        inlineScript.type = "text/partytown";
        inlineScript.text = `
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', '${GA_ID}');
        `;
        document.head.appendChild(inlineScript);
      };

      const consent = localStorage.getItem("analytics-consent");

      if (consent === "granted") {
        injectGA(); // auto-load if already accepted
        return; // hide banner
      }
      if (consent === "denied") return; // hide banner

      // Show banner if no consent
      banner.style.display = "block";

      const acceptBtn = document.getElementById("accept-cookies");
      const rejectBtn = document.getElementById("reject-cookies");

      acceptBtn.addEventListener("click", () => {
        localStorage.setItem("analytics-consent", "granted");
        banner.style.display = "none";
        injectGA();
        location.reload(); // reload the page to trigger GA in BaseHead
      });

      rejectBtn.addEventListener("click", () => {
        localStorage.setItem("analytics-consent", "denied");
        banner.style.display = "none";
      });
    })();
  </script>

  <style>
    .cookie-banner {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      max-width: 300px;
      background-color: var(--fallback-b1, oklch(var(--b1) / var(--tw-bg-opacity)));
      --tw-bg-opacity: 0.9;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: all 0.1s ease-in-out;
      padding: 1rem;
      border: 1px solid var(--border-color, #eee);
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      border-radius: 0.5rem;
      font-size: 14px;
      z-index: 1000;
    }
    .cookie-banner p {
      margin:0 0 0.5rem 0;
      color:#818181;
      font-size:14px;
    }
    .cookie-banner .buttons {
      display:flex;
      justify-content:flex-end;
      gap:0.5rem;
    }
    .cookie-banner button {
      padding:0.4rem 0.8rem;
      border:none;
      border-radius:4px;
      cursor:pointer;
      font-size:13px;
    }
    .cookie-banner button#accept-cookies {
      background: #1cd945;
      color: #fff;
      backdrop-filter: none;
    }
    .cookie-banner button#reject-cookies {
      background: rgb(209, 14, 14);
      color: #fff;
      backdrop-filter: none;
    }
  </style>
</div>
