<div client:load transition:persist>
  <div id="cookie-banner" class="cookie-banner" style="display:none;">
    <p>
      I use cookies for analytics. This helps me improve my Portfolio.
      <br/><br/>
      Do you accept cookies? 🍪
    </p>
    <div class="buttons">
      <button id="accept-cookies">Accept</button>
      <button id="reject-cookies">Reject</button>
    </div>
  </div>

  <script is:inline>
    (() => {
      if (window.__cookieBannerInitialized) return;
      window.__cookieBannerInitialized = true;

      const banner = document.getElementById("cookie-banner");
      if (!banner) return;

      const GA_ID = "G-55XW4V0S7F";

      const injectGA = () => {
        if (window.__gaInjected) return;
        window.__gaInjected = true;

        // Load GA script
        const gaScript = document.createElement("script");
        gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        gaScript.async = true;
        document.head.appendChild(gaScript);

        // Init GA
        const inlineScript = document.createElement("script");
        inlineScript.textContent = `
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${GA_ID}', {
            page_path: window.location.pathname,
            page_title: document.title
          });
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted'
          });
        `;
        document.head.appendChild(inlineScript);

        console.log("[CookieBanner] GA dynamically injected ✅");

        // Track initial pageview
        trackPageView();

        // Track Astro transitions
        document.addEventListener("astro:page-load", trackPageView);
      };

      const trackPageView = () => {
        if (window.gtag) {
          window.gtag("event", "page_view", {
            page_path: window.location.pathname,
            page_title: document.title
          });
          console.log("[CookieBanner] GA page_view sent ✅", window.location.pathname);
        }
      };

      const showBanner = () => {
        const consent = localStorage.getItem("analytics-consent");

        if (consent === "granted") {
          banner.style.display = "none";
          injectGA();
          return;
        }

        if (consent === "denied") {
          banner.style.display = "none";
          console.log("[CookieBanner] GA injection declined ❌");
          return;
        }

        // Show banner if no consent
        banner.style.display = "block";

        document.getElementById("accept-cookies")?.addEventListener("click", () => {
          localStorage.setItem("analytics-consent", "granted");
          banner.style.display = "none";
          injectGA();
        });

        document.getElementById("reject-cookies")?.addEventListener("click", () => {
          localStorage.setItem("analytics-consent", "denied");
          banner.style.display = "none";
          console.log("[CookieBanner] GA injection declined ❌");
        });
      };

      showBanner();
      document.addEventListener("astro:page-load", showBanner);
    })();
  </script>
</div>


  <style>
    .cookie-banner {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      max-width: 300px;
      background-color: var(--fallback-b1, oklch(var(--b1) / var(--tw-bg-opacity)));
      --tw-bg-opacity: 0.9;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: all 0.1s ease-in-out;
      padding: 1rem;
      border: 1px solid var(--border-color, #eee);
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      border-radius: 0.5rem;
      font-size: 14px;
      z-index: 1000;
    }
    .cookie-banner p {
      margin:0 0 0.5rem 0;
      color:#818181;
      font-size:14px;
    }
    .cookie-banner .buttons {
      display:flex;
      justify-content:flex-end;
      gap:0.5rem;
    }
    .cookie-banner button {
      padding:0.4rem 0.8rem;
      border:none;
      border-radius:4px;
      cursor:pointer;
      font-size:13px;
    }
    .cookie-banner button#accept-cookies {
      background: #1cd945;
      color: #fff;
      backdrop-filter: none;
    }
    .cookie-banner button#reject-cookies {
      background: rgb(209, 14, 14);
      color: #fff;
      backdrop-filter: none;
    }
  </style>
</div>
